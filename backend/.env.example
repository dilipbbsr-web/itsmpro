# ─── SERVER ──────────────────────────────────────
NODE_ENV=production
PORT=5000
FRONTEND_URL=http://localhost:3000

# ─── DATABASE ─────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=itsmpro
DB_USER=itsmpro_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL=false

# ─── JWT AUTH ─────────────────────────────────────
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_RANDOM_64_CHAR_STRING
JWT_REFRESH_EXPIRES_IN=7d

# ─── BCRYPT ───────────────────────────────────────
BCRYPT_ROUNDS=12

# ─── EMAIL (SMTP) ─────────────────────────────────
SMTP_HOST=smtp.company.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@company.com
SMTP_PASS=CHANGE_THIS
EMAIL_FROM=ITSM Pro <noreply@company.com>

# ─── FILE UPLOADS ─────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ─── RATE LIMITING ────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# ─── LOGGING ──────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# ─── INTEGRATIONS (optional) ──────────────────────
SLACK_WEBHOOK_URL=
PAGERDUTY_API_KEY=
